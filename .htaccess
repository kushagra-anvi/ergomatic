Options -Indexes

RewriteEngine On
RewriteRule ^sitemap\.xml$ sitemap.php [L]
RewriteRule ^robots\.txt$ robots.php [L]

Redirect 301 /news.html /news.php

RewriteCond %{REQUEST_FILENAME} !-f
RewriteCond %{REQUEST_FILENAME} !-d
RewriteRule ^([a-z0-9]+(?:-[a-z0-9]+)*)/?$ article.php?slug=$1 [QSA,L]

<Files "config.local.php">
    Require all denied
</Files>

<FilesMatch "\.sql$">
    Require all denied
</FilesMatch>
